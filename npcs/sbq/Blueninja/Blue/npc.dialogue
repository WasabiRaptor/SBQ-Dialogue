  "tailInfusedOccupant": "/npcs/sbq/dialogue/default.dialogue:tailInfusedOccupant",
  "strugglingBelly": [
    [
      "嗯嗯,根据我的计算,相当舒服～",
      "哦,你的肚子似乎很适合我,我在里面好舒服～",
      {
        "check": {
          "bellySounds": true
        },
        "add": [
          "你的肚子发出的咕噜声对我的听觉接收器来说太舒缓了～",
          "嗯…… 我应该把这些声音保存到记忆里,这样就能播放着入睡了～"
        ]
      }
    ],
    {
      "check": {
        "predator": [
          "sbqVaporeon",
          "vaporeon"
        ]
      },
      "add": [
        "这是不是意味着…… 你抓住我了？",
        "你的身体很有趣,就像被水床挤压着～"
      ]
    }
  ],
  "strugglingWomb": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:strugglingWomb",
  "strugglingTail": "/npcs/sbq/dialogue/default.dialogue:strugglingTail",
  "strugglingBreasts": "/npcs/sbq/dialogue/default.dialogue:strugglingBreasts",
  "strugglingBreastsShirt": "/npcs/sbq/dialogue/default.dialogue:strugglingBreastsShirt",
  "strugglingPussy": "/npcs/sbq/dialogue/default.dialogue:strugglingPussy",
  "strugglingCock": [
    "啊～你这紧紧的感觉在考验我的抗压能力呢",
    "我还是会拼命扭动的,所以别  自大  哦,嘿～",
    "这太淫荡了！~ 我可不是玩具,就算我看起来像,而且也喜欢被当成玩具对待～"
  ],
  "strugglingBalls": [
    "这太淫荡了！但我喜欢～…… 我要把这个想法存进一个秘密文件里……",
    "被存放在这里…… 这是不是意味着我们是朋友了？！~",
    "当你说  一起玩  时,我没想到你指的是这个,但我不抱怨～",
    "我很高兴有个先进的冷却系统,因为这里超级热～"
  ],
  "strugglingAss": "/npcs/sbq/dialogue/default.dialogue:strugglingAss",
  "strugglingAcidHeal": [
    [
      "啊…… 好舒服,",
      "我真不敢相信你的治愈能力,连我的金属部件都能修复～",
      "舒适度 100%,修复剩余时间…… 嗯,等我小睡一会儿再说吧？",
      {
        "check": {
          "bellySounds": true
        },
        "add": [
          "你的肚子发出的咕噜声对我的听觉接收器来说太舒缓了～",
          "嗯…… 我应该把这些声音保存到记忆里,这样就能播放着入睡了～"
        ]
      }
    ],
    {
      "check": {
        "predator": [
          "sbqVaporeon",
          "vaporeon"
        ]
      },
      "add": [
        "这个肚子里的液体就像治愈之水！感觉太棒了"
      ]
    }
  ],
