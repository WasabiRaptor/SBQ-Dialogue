  "oralVoreDigestFull": [
    "正在进行燃料补充:等我处理完这个,就轮到你了",
    "嗝！\n 燃料补充完成还需要一点时间,之后你就是我的了～",
    "我吃了这个,电池差不多快满了,但等我处理完,就能把你也 装 进来",
    "我得先把这顿饭消化完,"
  ],
  "oralVoreCompressionFull": "/npcs/sbq/FFWizard/Helena/npc.dialogue:oralVoreCompressionFull",
  "needsInfusion": ":oralVoreNeedsInfusion",
  "struggle": ":struggleBelly",
  "struggleHeal": ":struggleAcidHeal",
  "struggleDigestCock": ":struggleFemcumDigest",
  "oralVoreLetoutForcedDigest": [
    "真讨厌…… 我还饿着呐,",
    "别往心里去,好吗？",
    "拜托,你都快 消化 完了……",
    "要是你不那么能反抗就好了……"
  ],
  "oralVoreLetoutForcedDigestImmune": "/npcs/sbq/AkariKaen/Akari/npc.dialogue:oralVoreLetoutForcedSoftDigestImmune",
  "oralVoreLetoutForcedSoftDigest": [
    "真可恶…… 我饿着呢,反正你也不会有事,",
    "别生气哈？我又没打算把你完全 消化 掉……",
    "拜托,你都快 消化 完了……",
    "要是你不那么能反抗就好了……"
  ],
  "oralVoreLetoutForcedHeal": [
    "你知道待在我身体里更安全,对吧？",
    "你真的…… 确定要出来吗？",
    "我通过传感器知道你已经痊愈了…… 但看到你离开,我还是很难过,",
    "你随时都能回来,再次恢复健康并被 储存 起来,"
  ],
  "oralVoreLetoutRequestedDigested": "/npcs/sbq/LokiVulpix/Loki/npc.dialogue:oralVoreLetoutRequestedDigested",
  "oralVoreLetoutRequestedDigest": [
    "其实…… 你在里面待的时间够长了,",
    "我现在已经不那么饿了,",
    "或许最好还是把你弄出来……",
    "不想把你完全融化掉,"
  ],
  "oralVoreLetoutRequestedDigestImmune": [
    "我根本就没法把你融化掉……",
    "有你在里面,我的饥饿感也无法缓解,",
    "或许最好还是把你弄出来,这样我就能吃点别的了,",
    "连一点点都融化不了你,"
  ],
  "oralVoreLetoutRequestedSoftDigest": ":oralVoreLetoutRequestedDigest",
  "oralVoreLetoutRequestedHeal": "/npcs/sbq/FFWizard/Helena/npc.dialogue:oralVoreLetoutRequestedHeal",
  "analVoreLetoutRequestedDigested": ":oralVoreLetoutRequestedDigested",
  "analVoreLetoutRequestedDigest": "/npcs/sbq/FFWizard/Helena/npc.dialogue:analVoreLetoutRequestedDigest",
  "analVoreLetoutRequestedDigestImmune": [
    "那就从我的 出口 出去吧,反正它也没法把你软化,",
    "你可以走了,因为我的  底部 根本没法融化你,"
  ],
  "analVoreLetoutRequestedSoftDigest": ":analVoreLetoutRequestedDigest",
  "analVoreLetoutRequestedHeal": "/npcs/sbq/FFWizard/Helena/npc.dialogue:analVoreLetoutRequestedHeal",
  "tailVoreLetoutRequestedDigested": ":oralVoreLetoutRequestedDigested",
  "navelVoreLetoutRequestedDigested": ":oralVoreLetoutRequestedDigested",
  "absorbVoreLetoutRequestedDigested": ":oralVoreLetoutRequestedDigested",
  "cockVoreLetoutRequestedDigest": [
    "嗯…… 也许我不会把你完全融化掉……"
  ],
  "cockVoreLetoutRequestedDigestImmune": [
    "我好像没法把你融化…… 所以放你走吧,"
  ],
  "cockVoreLetoutRequestedSoftDigest": ":cockVoreLetoutRequestedDigest",
  "cockVoreLetoutRequestedHeal": "/npcs/sbq/FFWizard/Helena/npc.dialogue:cockVoreLetoutRequestedHeal",
  "unbirthVoreLetoutRequestedDigest": [
    "嗯…… 在你完全融化成液体之前,先停一下吧,嘿嘿～"
  ],
  "unbirthVoreLetoutRequestedDigestImmune": [
    "看起来你不会融化,所以我要把你放出来,"
  ],
  "unbirthVoreLetoutRequestedSoftDigest": ":unbirthVoreLetoutRequestedDigest",
  "unbirthVoreLetoutRequestedHeal": "/npcs/sbq/FFWizard/Helena/npc.dialogue:unbirthVoreLetoutRequestedHeal",
  "strugglingSlime": [
    "这情况可真黏糊！",
    "被困住了…… 逃脱的可能性:渺茫……",
    "希望这只是这家伙表达亲热的方式……"
  ],
  "strugglingSlimeDigestImmune": [
    [
      "嘿,想把我融成更多黏液？",
      "嘿,想把我融成更多黏液？\n 那可不管用,"
    ],
    "抱歉,我可溶解不了,",
    "你得再加把劲才能把我吸收掉,"
  ],
  "strugglingSlimeHeal": [
    "奇怪,这黏液好像有修复的功效…… 而且感觉还不错～",
    "啊…… 我不太能动,但这黏液好像很友好,所以待在这儿也不算太糟,我想",
    "嗯嗯…… 我想我能习惯这种感觉…… 有了这 抱抱黏液 ,还要什么维修舱～"
  ],
  "strugglingSlimeTransforming": [
    "啊…… 我正在变成黏液……",
    "感觉我的四肢都在变成果冻……"
  ],
