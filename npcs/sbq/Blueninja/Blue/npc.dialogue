  "struggleTail": "/npcs/sbq/dialogue/default.dialogue:struggleTail",
  "struggleBreasts": "/npcs/sbq/dialogue/default.dialogue:struggleBreasts",
  "struggleBreastsShirt": "/npcs/sbq/dialogue/default.dialogue:struggleBreastsShirt",
  "strugglePussy": "/npcs/sbq/dialogue/default.dialogue:strugglePussy",
  "struggleCock": [
    "哦 - 哦？！小心点！你可能会滑得更深,除非你想这样,那就请便～",
    "里面很热吗？我得承认,确实挺热的～",
    "天 - 呐！你在里面的感觉真是…… 太棒了～"
  ],
  "struggleBalls": [
    "你在里面  玩得开心  吗？呵呵～",
    "哇！你在里面  疯狂扭动  呢！嘿～",
    "感觉你在里面扭动真不错,你应该  多来几次 ,嘿～",
    "他们怎么说来着？朋友都 存 在蛋蛋里？我同意～"
  ],
  "struggleAss": "/npcs/sbq/dialogue/default.dialogue:struggleAss",
  "struggleAcidHeal": [
    "我的  医疗舱  怎么样,哈！明白这个梗吧？（注:这里原文是med-bay-ly,我没看懂.A）",
    "所有舒适程序都运行正常,你应该感觉很棒～",
    "我会确保你完全康复,但即使你已经好了,也可以留下来～"
  ],
  "struggleFemcumHeal": "/npcs/sbq/dialogue/default.dialogue:struggleFemcumHeal",
  "struggleCumHeal": ":struggleAcidHeal",
  "struggleMilkHeal": "/npcs/sbq/LokiVulpix/Loki/npc.dialogue:struggleMilkHeal",
  "struggleMiscHeal": ":struggleAcidHeal",
  "struggleCompression": "/npcs/sbq/dialogue/default.dialogue:struggleCompression",
  "struggleAcidDigest": [
    "是时候把你熔化成生物燃料了,",
    "乖乖当块电池,熔化吧,"
  ],
  "struggleAcidDigestImmune": "/npcs/sbq/Zygahedron/Zevi/npc.dialogue:struggleAcidDigestImmune",
  "struggleCumDigest": "/npcs/sbq/dialogue/default.dialogue:struggleCumDigest",
