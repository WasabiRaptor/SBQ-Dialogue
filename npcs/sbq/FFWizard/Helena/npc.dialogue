  },
  "oralVoreLetoutForcedDigestImmuneFiendly": {
    "dialogueRandom": [
      "^red; 你之前挺好的。",
      "^red; 感觉还不错，不是吗？",
      "^red; 没造成什么伤害。",
      "^red; 那你自便吧。"
    ],
    "imagePortrait": [
      "HMad.png"
    ]
  },
  "oralVoreLetoutForcedDigestedFiendly": {
    "dialogueRandom": [
      "^red; 想出来？稍等一下。",
      "^red; 不想再胖着了？好吧。",
      "^red; 小心点。你现在很虚弱。",
      "^red; 那我把你重组一下。"
    ],
    "imagePortrait": [
      "HMad.png"
    ]
  },
  "oralVoreLetoutFiendly": {
    "dialogueRandom": [
      "^red; 现在安全了。出来吧。",
      "^red; 这样应该行了。你出来吧。",
      "^red; 没看到敌人。我放你出来。",
      "^red; 我已经处理好了。"
    ],
    "imagePortrait": [
      "HMad.png"
    ]
  },
  "oralVoreLetoutHealFiendly": {
    "dialogueRandom": [
      "^red; 你现在好了。我把你推出去。",
      "^red; 要是受伤了就回来。",
      "^red; 你能战斗吗？行，我弄完了。",
      "^red; 别谢我。我总会帮忙的。"
    ],
    "imagePortrait": [
      "HMad.png"
    ]
  },
  "oralVoreLetoutDigestFiendly": {
    "dialogueRandom": [
      "^red; 你在融化。该离开了。",
      "^red; 抱歉。得放你出去。",
      "^red; 该死，现在不行。我的肚子不安全。",
      "^red; 快失控了。我得放你出去。"
    ],
    "imagePortrait": [
      "HMad.png"
    ]
  },
  "oralVoreLetoutDigestedFiendly": {
    "dialogueRandom": [
      "^red; 安全了。我会重组你。",
      "^red; 他们找不到你。把你变回来。",
      "^red; 胖点挺好。但当燃料用就不好了。出去吧。",
