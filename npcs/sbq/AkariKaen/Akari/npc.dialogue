  "targetPreySettingsMismatch": ":oralVoreTargetPreySettingsMismatch",
  "cockVoreRequested": [
    "哈哈,馋鲨狗族的鸡儿了",
    "咩噗？你想进我鸡儿里？",
    "希望你能塞得下",
    "嗯？那就进来吧"
  ],
  "cockVoreRequestedAfter": [
    "哦哦,我的咩噗,这让我硬起来了～",
    "嗯嗯～你让这只鲨狗族超开心的",
    "太好了... 我硬了.. 希望没人注意到...",
    "咩... 咩噗咩噗～"
  ],
  "cockVoreInvalid": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:cockVoreInvalid",
  "cockVoreNo": [
    "没心情,伙计",
    "我忙着呢",
    "也许晚点吧,我刚自己解决过一会儿了",
    "我还有其他鲨狗族的事儿要做... 比如咩噗叫",
    "我的鸡儿累了"
  ],
  "cockVoreTooBig": [
