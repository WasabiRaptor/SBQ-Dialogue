  "oralVoreForcing": "/npcs/sbq/dialogue/default.dialogue:oralVoreForcing",
  "cockVoreForcing": "/npcs/sbq/dialogue/default.dialogue:cockVoreForcing",
  "oralVoreLetoutForcingAfter": [
