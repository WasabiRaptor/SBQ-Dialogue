  "cockVoreNoPromptAfter": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:cockVoreNoPromptAfter",
  "oralVoreUnprompted": [
    "呃,好黏糊",
    "很乐意把你填满 ^^",
