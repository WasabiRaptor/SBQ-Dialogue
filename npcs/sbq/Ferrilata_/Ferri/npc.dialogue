{
  "greetingRewards": "/npcs/sbq/dialogue/default.dialogue:greetingRewards",
  "greetingRewardsIntroduced": "/npcs/sbq/dialogue/default.dialogue:greetingRewardsIntroduced",
  "greeting": {
    "dialogueRandom": [
      "你好呀,",
      "欢迎！",
      "嗨！很高兴见到你,"
    ],
    "imagePortrait": [
      "Neutral.png"
    ],
    "buttonTextRandom": [
      "嗨,",
      "谢谢,",
      "嗨呀,我也很高兴见到你,"
    ]
  },
  "greetingHorny": {
    "dialogueRandom": [
      "我憋得太久了…… 得释放释放～",
      "嗯嗯嗯…… 我一直在想那些捕食者……",
      "嗯嗯嗯～…… 哦！抱歉,我刚刚在幻想些事儿,"
    ],
    "imagePortrait": [
      "Uwu.png"
    ],
    "buttonTextRandom": [
      "呃,好吧,",
      "真有意思,",
      "我真想象不出你在想啥,"
    ]
  },
  "greetingHungry": {
    "dialogueRandom": [
      "嗯嗯嗯…… 嗯嗯嗯……",
      " 迫不及待想蜷起来…… 睡一觉…… 想*（听不清）*……",
      "*（喃喃自语）*嗯…… 我想该睡觉了……"
    ],
    "imagePortrait": [
      "Sleepy.png"
    ],
    "buttonTextRandom": [
      "呃,嗨,",
      "你好？",
      "你好啊,"
    ]
  },
  "greetingCrew": "/npcs/sbq/dialogue/default.dialogue:greetingCrew",
  "crewStay": "/npcs/sbq/dialogue/default.dialogue:crewStay",
  "fullCrew": "/npcs/sbq/dialogue/default.dialogue:fullCrew",
  "crewFollow": "/npcs/sbq/dialogue/default.dialogue:crewFollow",
  "converse": {
    "dialogueRandom": [
      "那么,有什么事吗？",
      "最近怎么样？",
      "什么风把你吹来了？"
    ],
    "buttonTextRandom": [
      "只是想闲逛一下,",
      "我想问点事儿,",
      "我想聊聊天,"
    ]
  },
  "curious": {
    "dialogueRandom": [
      "想待多久就待多久！",
      "你想问啥？",
      "嗯？"
    ],
    "buttonText": ":choosePrompt"
  },
  "curiousWhoAreYou": {
    "dialogue": [
      "我叫费里斯,但大家都叫我 ^orange;费里 ^reset;,因为这听起来很可爱,我是一只猫狐,有时候会画画和制作些东西,你是谁呢？",
      "很高兴认识你, <entityName>,我觉得我们会成为好朋友的！",
      "哦,要是有任何我能帮上忙的事儿,我很乐意,只要是在这个世界里的事就行,"
    ],
    "buttonText": [
      "我叫……",
      "谢谢你！我也一样。",
      "我会记住的。"
    ]
  },
  "curiousCatfox": {
    "dialogue": [
      "你的认知，真迷人！这就是我。我有这对狞猫耳朵，橙白相间的毛，一个小粉鼻子，跖行足，还有一条大大的毛茸茸的尾巴！这都是我一直梦寐以求拥有的，我很感激。",
      "以前没有！你知道吗，我曾经是个人类。",
      "真的！",
      "嗯，有一次我遇到一个奇怪的生物。它看起来像由黏液组成的。我试着去摸它，然后它把我吞了，接着变成了我，然后我们就变成了这个样子！",
      "哇，说得没错！我很惊讶它居然完全知道我想成为什么样子！它现在也还和我在一起，就像我脑海深处的一个小声音。",
      "当然不正常啦！但被黏液变成一只动物，这也不太正常吧～！"
    ],
    "buttonText": [
      "一直梦寐以求拥有？你是说你以前没有这些？",
      "真的吗？",
      "那后来发生了什么？你是怎么变成猫狐的？",
      "哇哦。",
      "脑海里的一个声音？费里，我觉得这不太正常。",
      "有道理。嗯，很高兴这对你来说很有趣！"
    ]
  },
  "curiousHelp": {
    "dialogue": [
      "是的！还记得我跟你说过发生在我身上的事吗？嗯，如果你用力推我的身体，它就会把你吞进去。",
      "没错！",
      "我提起这个是因为，如果有人在里面，它就能开始治愈他们！",
      "或者也把他们变成猫狐。",
      "我还有一项特殊技能，万一我们遭到攻击就能用上！",
      "就是这把枪。",
      "很高兴你赞同！！我还有另一种帮忙的方式。要是你饿了，我，呃…… 嗯，你可以吃了我。我不介意的～。"
    ],
    "buttonText": [
      "像黏液一样？",
      "哈。那你为什么提起这个？",
      "哦，太棒了！",
      "啊。",
      "继续说。",
      "这真是一项很棒的技能。",
      "哦。我会记住的。"
    ]
  },
  "questionAnswered1": {
    "dialogueRandom": [
      "那么，你还有其他想知道的吗？",
      "关于这个我就说这么多了。还有别的事吗？"
    ],
    "buttonText": [
      "有."
    ]
  },
  "questionAnswered2": [
    "当然！尽管问。",
    "太好了！！"
  ],
  "rewardNotifyMoney": [
    "给，拿着这些钱！",
    "谢谢你带来的欢乐！！给，收下这个！！"
  ],
  "rewardNotifyLowValueQuestRewards": [
    "给！拿着这个。",
    "谢谢你带来的欢乐！！给，收下这个。"
  ],
  "rewardNotifyMediumValueQuestRewards": [
    "也许这次我有更好的东西给你。",
    "我有个礼物给你。"
  ],
  "rewardNotifyHighValueQuestRewards": [
    "我觉得你会很喜欢我给你准备的东西。",
    "（《命令与征服：泰伯利亚黎明》突击队员的声音）“我有个礼物给你！”"
  ],
