  "tailVoreLetoutForced": "/npcs/sbq/dialogue/default.dialogue:tailVoreLetoutForced",
  "analVoreLetoutForced": ":oralVoreLetoutForced",
  "unbirthVoreLetoutForced": [
    "生日快乐～",
    "啊～你为什么出来了？",
    "嗯～我还以为你很舒服呢？",
    "我以为你喜欢待在里面呢～？",
