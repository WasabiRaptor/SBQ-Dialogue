  "gotStomped": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:gotStomped",
  "converse.options.0.1": [
    " 很高兴认识你，<entityname>~",
    "也许稍后我可以让你参与我的一场表演`"
  ],
  "converse.options.2.1.default": [
    "我应该有足够的空间让你消失在里面～"
  ],
  "converse.options.2.1.heal": [
    "你藏在里面，应该会很放松～"
  ],
  "converse.options.2.1.softDigest": [
    "一旦你藏好，你可能会发现自己正衬着我的肚子～"
  ],
  "converse.options.3.1.default": [
    "在那里应该会很舒服，多亏了<entityName>~"
  ],
  "converse.options.3.1.heal": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:converse.options.5.1.heal",
  "converse.options.4.1.default": [
    " 非常柔软，从<entityName>借来的～"
  ],
  "converse.options.4.1.heal": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:converse.options.5.1.heal",
  "converse.options.4.1.softDigest": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:converse.options.5.1.softDigest",
  "converse.options.5.1.default": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:converse.options.7.1.default",
  "converse.options.5.1.default.continue.defaultInfused": "/npcs/sbq/LokiVulpix/Loki/npc.dialogue:converse.options.6.1.default.continue.defaultInfused",
  "converse.options.6.1.default": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:converse.options.7.1.default",
  "converse.options.6.1.softDigest": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:converse.options.7.1.softDigest",
  "talkAboutSelf": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:talkAboutSelf",
  "talkAboutSelf.options.0.1": [
    "我是一只魔幻假面喵，我的颜色像秋天一样！我的名字某种程度上取自梅花这一扑克牌花色。"
  ],
  "talkAboutSelf.options.1.1": [
    "这可真是个值得问的问题～简直就像邀请我在解释的时候来做个示范～"
  ],
  "talkAboutKinks": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:talkAboutKinks",
  "talkAboutKinks.options.0.1": [
    "嗯～这总是一场很受欢迎的表演，把观众聚集起来... 挑选一个看起来体型大得离谱的人...",
    "然后迅速地让他们毫无踪迹地消失在我的喉咙里，我的肚子立刻挤压并压实他们～",
    "我会试着把任何东西都吞进去，过一会儿，他们在我光滑的肚子上几乎留不下任何痕迹～"
  ],
  "talkAboutKinks.options.0.1.continue": [
    "你想成为那样的猎物吗？"
  ],
  "talkAboutKinks.options.0.1.continue.options.0.1": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:talkAboutKinks.options.0.1.continue.options.0.1",
  "talkAboutKinks.options.0.1.continue.options.1.1": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:talkAboutKinks.options.0.1.continue.options.1.1",
  "talkAboutKinks.options.1.1": [
    "对切莉很好奇，嗯～？还是说我不小心泄露了她的秘密，哎呀～",
    "当我占有某个人时，我一定会充分利用他们，尤其是当他们成为我的助手时～",
    "而她确实在重要的方面提供了帮助，她让我增加的那些体型？她就在我两腿之间悸动着～",
    "而且她也知道这一点，基本上她就住在那里，到现在为止，她作为我的一部分度过的时间比不是我的一部分的时间还多～",
    "这正是我喜欢的方式～当人们情不自禁地享受其中，只想成为我的一部分～"
  ],
  "talkAboutKinks.options.1.1.continue": [
    "<slowlove>你想有朝一日成为我的阴茎吗～？"
  ],
  "talkAboutKinks.options.1.1.continue.options.0.1": [
    "<slowlove>太好了！那我们改天可以找点乐子～"
  ]
}
